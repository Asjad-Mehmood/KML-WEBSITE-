# Copy this file to `.env` and replace the placeholder with your real connection string.
# Never commit real credentials — `.env` is git-ignored, this example file is not.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Password-reset emails (set real values in .env and in Vercel → Settings → Environment Variables)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = a Google "App Password" (not your normal password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Admin sign-in from a new browser needs a 6-digit code emailed to the admin.
# It is on whenever SMTP above is set up. Emergency switch only: ADMIN_OTP=off
ADMIN_OTP=""

# Signs reset links. 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Public site address used in emailed links
NEXT_PUBLIC_SITE_URL="https://www.exceltokml.com"
# The web app's page is read from the program's private repository (Asjad-Mehmood/kml-convertor-src).
# A fine-grained GitHub token with only "Contents: Read-only" on that repository. Without it the
# site serves its saved copy in public/app.html. Set it in Vercel → Settings → Environment Variables.
APP_SOURCE_TOKEN=""
# "Continue with Google" (optional; the button shows only when both are set). Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application), with this Authorized redirect URI:
#   https://www.exceltokml.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Nightly clean-up (vercel.json cron → /api/cron/cleanup). Stored files and their points older than
# this many days are deleted; 0 keeps them forever. Default 365.
FILE_RETENTION_DAYS=365
# Any long random string. Vercel sends it to the cron route so nobody else can trigger it.
CRON_SECRET=

# Facebook: the official Page's address, shown in the footer and in the site's
# structured data. Optional: defaults to https://www.facebook.com/RealAm025
NEXT_PUBLIC_FACEBOOK_URL=""
# Meta domain verification: the content="…" value from Meta Business Suite →
# Brand safety → Domains → Add → "Meta-tag verification". Redeploy after setting.
FACEBOOK_DOMAIN_VERIFICATION=""
