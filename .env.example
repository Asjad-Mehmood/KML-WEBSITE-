# Copy this file to `.env` and replace the placeholder with your real connection string.
# Never commit real credentials — `.env` is git-ignored, this example file is not.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Password-reset emails (set real values in .env and in Vercel → Settings → Environment Variables)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = a Google "App Password" (not your normal password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Admin sign-in from a new browser needs a 6-digit code emailed to the admin.
# It is on whenever SMTP above is set up. Emergency switch only: ADMIN_OTP=off
ADMIN_OTP=""

# Signs reset links. 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Public site address used in emailed links
NEXT_PUBLIC_SITE_URL="https://www.exceltokml.com"
# The web app's page is read from the program's private repository (Asjad-Mehmood/kml-convertor-src).
# A fine-grained GitHub token with only "Contents: Read-only" on that repository. Without it the
# site serves its saved copy in public/app.html. Set it in Vercel → Settings → Environment Variables.
APP_SOURCE_TOKEN=""
# "Continue with Google" (optional; the button shows only when both are set). Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application), with this Authorized redirect URI:
#   https://www.exceltokml.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Nightly clean-up (vercel.json cron → /api/cron/cleanup). Stored files and their points older than
# this many days are deleted; 0 keeps them forever. Default 365.
FILE_RETENTION_DAYS=365
# Any long random string. Vercel sends it to the cron route so nobody else can trigger it.
CRON_SECRET=

# Facebook: the official Page's address, shown in the footer and in the site's
# structured data. Optional: defaults to https://www.facebook.com/RealAm025
NEXT_PUBLIC_FACEBOOK_URL=""
# Meta domain verification: the content="…" value from Meta Business Suite →
# Brand safety → Domains → Add → "Meta-tag verification". Redeploy after setting.
FACEBOOK_DOMAIN_VERIFICATION=""

# Admin on an address of its own (lib/adminHost.ts). Set it only once the domain is added in
# Vercel. Then /admin and the admin APIs answer only there, only admins can sign in there, and
# only those sessions have admin rights. Leave empty to keep admin on the main site.
ADMIN_HOST=

# Sign-in on an address of its own (lib/authHost.ts), e.g. auth.exceltokml.com. Set it only
# once the domain is added in Vercel and its Google callback
# (https://auth.exceltokml.com/api/auth/google/callback) is in Google Cloud; then deploy.
# Leave empty to keep sign-in on the main site.
NEXT_PUBLIC_AUTH_HOST=

# The users' dashboard on an address of its own (lib/dashboardHost.ts), e.g.
# account.exceltokml.com. Set it once the domain is added in Vercel; then deploy. Leave empty to
# keep the dashboard on the main site.
NEXT_PUBLIC_DASHBOARD_HOST=

# Paid plans for the web apps: switched on and off in Admin → Payments (everything starts off).
# BILLING_FORCE_OFF=1 is the emergency stop: all of it off, whatever the switches say.
# BILLING_ENABLED=1 turns all of it on for a computer or a preview (never the live site).
BILLING_FORCE_OFF=
BILLING_ENABLED=

# Payments for Pro: Paddle (lib/paddle.ts). Admin → Payments checks each one against Paddle.
# "sandbox" uses test cards and no real money; "production" takes real payments.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
