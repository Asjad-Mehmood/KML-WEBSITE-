generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  salt            String
  organization    String?    @default("Independent Surveyor")
  role            String?    @default("Cadastral Surveyor")
  downloadCount   Int        @default(0)
  ipAddress       String?
  location        String?
  hasFullAccess   Boolean?   @default(false)
  customMaxPoints Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime   @default(now())

  sessions        Session[]
  downloads       Download[]
  activities      Activity[]
  files           UserFile[]
  jobs            UserJob[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

model Download {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  assetType String   @default("windows_installer")
  fileName  String
  version   String   @default("v3.5.5")
  ipAddress String?
  location  String?
  userAgent String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("downloads")
}

model Conversion {
  id          String   @id @default(cuid())
  userId      String?
  station     String
  featureCode String
  easting     Float
  northing    Float
  /// null when the point has no level (not 0, which is a real level)
  elevation   Float?
  coordSystem String
  lat         String
  lon         String
  timestamp   DateTime @default(now())

  @@map("conversions")
}

model Activity {
  id            String   @id @default(cuid())
  userId        String?
  userEmail     String?
  userName      String?
  action        String
  title         String
  details       String?
  fileName      String?
  fileSize      String?
  pointsCount   Int?
  linesCount    Int?
  polygonsCount Int?
  crs           String?
  exportFormat  String?
  photosCount   Int?
  durationMs    Int?
  status        String?  @default("success")
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activities")
}

model UserFile {
  id                String   @id @default(cuid())
  userId            String?
  userEmail         String?
  userName          String?
  direction         String   @default("import")
  fileName          String
  fileSize          Int      @default(0)
  fileSizeFormatted String   @default("0 B")
  mimeType          String   @default("application/octet-stream")
  contentBase64     String?  @db.Text
  pointsCount       Int?
  crs               String?
  action            String?
  platform          String?  @default("windows_app")
  ipAddress         String?
  userAgent         String?
  timestamp         DateTime @default(now())

  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("user_files")
}

/// A job kept in the app, carried to the account so it opens on any computer.
/// `state` is the job as the app exports it (JSON, photos as base64).
/// The API creates this table on first use if `prisma db push` has not been run.
model UserJob {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  name          String
  points        Int      @default(0)
  photos        Int      @default(0)
  photosLeft    Int      @default(0)
  grid          String   @default("")
  size          Int      @default(0)
  /// "2 traverses · 1 level run": the Traverse adjust work in the job, for lists
  survey        String   @default("")
  state         String   @db.Text
  clientUpdated BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("user_jobs")
}

model AppSettings {
  id                    Int     @id @default(1)
  appVersion            String  @default("v3.5.7")
  installerFileName     String  @default("ExcelToKMLPro-Lite-Setup.exe")
  installerFileSize     String  @default("3.2 MB")
  requireAuthForDownload Boolean @default(true)
  maintenanceMode       Boolean @default(false)
  announcementBanner    String  @default("")
  announcementActive    Boolean @default(false)
  webAppRestricted      Boolean @default(true)
  webMaxPoints          Int     @default(50)
  webWatermarkKml       Boolean @default(true)
  webDisableReports     Boolean @default(true)

  @@map("app_settings")
}

model ContactMessage {
  id        String   @id @default(cuid())
  ref       String   @unique
  name      String
  email     String
  topic     String
  message   String   @db.Text
  details   String?  @db.Text
  userId    String?
  status    String   @default("new")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}
