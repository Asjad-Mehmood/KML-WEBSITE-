generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  salt            String
  organization    String?  @default("Independent Surveyor")
  role            String?  @default("Cadastral Surveyor")
  downloadCount   Int      @default(0)
  ipAddress       String?
  location        String?
  hasFullAccess   Boolean? @default(false)
  customMaxPoints Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime @default(now())

  sessions   Session[]
  downloads  Download[]
  activities Activity[]
  files      UserFile[]
  jobs       UserJob[]

  // tables the site creates itself (lib/*: ensure… functions)
  accountControl  AccountControl?
  appUsage        AppUsage[]
  referralCode    ReferralCode?
  referredBy      Referral?        @relation("referrals_referredIdTousers")
  referralsMade   Referral[]       @relation("referrals_referrerIdTousers")
  reviews         Review[]
  slopeJobs       SlopeJob[]
  subscription    Subscription?
  teamMemberships TeamMember[]
  teamShares      TeamShare[]
  ownedTeams      Team[]
  toolkitDevices  ToolkitDevice[]
  toolkitHandoffs ToolkitHandoff[]
  traverseJobs    TraverseJob[]
  emailStatus     UserEmailStatus?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

model Download {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  assetType String   @default("windows_installer")
  fileName  String
  version   String   @default("v3.5.5")
  ipAddress String?
  location  String?
  userAgent String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("downloads")
}

model Conversion {
  id          String   @id @default(cuid())
  userId      String?
  station     String
  featureCode String
  easting     Float
  northing    Float
  /// null when the point has no level (not 0, which is a real level)
  elevation   Float?
  coordSystem String
  lat         String
  lon         String
  timestamp   DateTime @default(now())

  @@map("conversions")
}

model Activity {
  id            String   @id @default(cuid())
  userId        String?
  userEmail     String?
  userName      String?
  action        String
  title         String
  details       String?
  fileName      String?
  fileSize      String?
  pointsCount   Int?
  linesCount    Int?
  polygonsCount Int?
  crs           String?
  exportFormat  String?
  photosCount   Int?
  durationMs    Int?
  status        String?  @default("success")
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  // added by lib/activityTags.ts
  app          String?
  platform     String?
  appVersion   String?
  errorMessage String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // created by lib/activityTags.ts
  @@index([app, timestamp])
  @@index([timestamp])
  @@map("activities")
}

model UserFile {
  id                String   @id @default(cuid())
  userId            String?
  userEmail         String?
  userName          String?
  direction         String   @default("import")
  fileName          String
  fileSize          Int      @default(0)
  fileSizeFormatted String   @default("0 B")
  mimeType          String   @default("application/octet-stream")
  contentBase64     String?  @db.Text
  pointsCount       Int?
  crs               String?
  action            String?
  platform          String?  @default("windows_app")
  ipAddress         String?
  userAgent         String?
  timestamp         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("user_files")
}

/// A job kept in the app, carried to the account so it opens on any computer.
/// `state` is the job as the app exports it (JSON, photos as base64).
/// The API creates this table on first use if `prisma db push` has not been run.
model UserJob {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  name          String
  points        Int      @default(0)
  photos        Int      @default(0)
  photosLeft    Int      @default(0)
  grid          String   @default("")
  size          Int      @default(0)
  /// "2 traverses · 1 level run": the Traverse adjust work in the job, for lists
  survey        String   @default("")
  state         String   @db.Text
  clientUpdated BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("user_jobs")
}

model AppSettings {
  id                     Int     @id @default(1)
  appVersion             String  @default("v3.5.7")
  installerFileName      String  @default("ExcelToKMLPro-Lite-Setup.exe")
  installerFileSize      String  @default("3.2 MB")
  requireAuthForDownload Boolean @default(true)
  maintenanceMode        Boolean @default(false)
  announcementBanner     String  @default("")
  announcementActive     Boolean @default(false)
  webAppRestricted       Boolean @default(true)
  webMaxPoints           Int     @default(50)
  webWatermarkKml        Boolean @default(true)
  webDisableReports      Boolean @default(true)

  @@map("app_settings")
}

model ContactMessage {
  id        String   @id @default(cuid())
  ref       String   @unique
  name      String
  email     String
  topic     String
  message   String   @db.Text
  details   String?  @db.Text
  userId    String?
  status    String   @default("new")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// Admin → Releases: every version of our software, grouped by app, which can be
// emailed to everyone with an account. Created on first use by lib/releases.ts.
model ProductRelease {
  id         String             @id @default(cuid())
  /// "excel-to-kml", or a product id from lib/products.ts ("roadpro", "traverse" …)
  app        String
  version    String
  releasedAt DateTime
  /// Headline, also the email subject
  title      String
  /// What's new, one item per line ("Title: text" makes the title bold)
  notes      String             @db.Text
  /// Download page, a site path (/roadpro) or an https URL
  link       String
  linkLabel  String             @default("")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  broadcasts ReleaseBroadcast[]

  @@unique([app, version])
  @@map("product_releases")
}

model ReleaseBroadcast {
  id         String             @id @default(cuid())
  releaseId  String
  release    ProductRelease     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  subject    String
  /// sending | paused | done
  status     String             @default("sending")
  total      Int                @default(0)
  sent       Int                @default(0)
  failed     Int                @default(0)
  lastError  String?
  createdBy  String
  /// app (people who downloaded or used the app) | all (everyone with an account)
  audience   String             @default("all")
  /// release (a version announcement) | review (asking the app's users to rate it)
  kind       String             @default("release")
  createdAt  DateTime           @default(now())
  finishedAt DateTime?
  recipients ReleaseRecipient[]

  @@index([releaseId])
  @@map("release_broadcasts")
}

model ReleaseRecipient {
  id          String           @id @default(cuid())
  broadcastId String
  broadcast   ReleaseBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  email       String
  name        String
  /// pending | sending | sent | failed
  status      String           @default("pending")
  error       String?
  claimedAt   DateTime?
  sentAt      DateTime?

  @@unique([broadcastId, email])
  @@index([broadcastId, status])
  @@map("release_recipients")
}

/// People who unsubscribed from release emails (the link in every broadcast)
model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())

  @@map("email_optouts")
}

// ---------------------------------------------------------------------------------------------
// Tables the site creates itself on first use (CREATE TABLE IF NOT EXISTS in lib/*.ts). They are
// listed here so the schema is complete: `prisma db push` keeps them, and they can be read with
// typed queries. Their shapes come from the database (`prisma db pull`).
// ---------------------------------------------------------------------------------------------

model AccountControl {
  userId          String    @id
  blocked         Boolean   @default(false)
  reason          String    @default("")
  blockedBy       String    @default("")
  blockedAt       DateTime?
  roleBeforeAdmin String    @default("")
  User            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_controls")
}

model AdminLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  adminEmail String   @default("")
  action     String
  target     String   @default("")
  details    String   @default("")
  ip         String   @default("")

  @@index([at])
  @@map("admin_log")
}

model AdminLoginCode {
  id            String    @id
  userId        String
  challengeHash String    @unique(map: "admin_login_codes_challenge_key")
  codeHash      String
  tries         Int       @default(0)
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt], map: "admin_login_codes_user_idx")
  @@map("admin_login_codes")
}

model AdminTrustedBrowser {
  id         String   @id
  userId     String
  tokenHash  String   @unique(map: "admin_trusted_browsers_token_key")
  label      String
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId], map: "admin_trusted_browsers_user_idx")
  @@map("admin_trusted_browsers")
}

model AppUsage {
  userId    String
  app       String
  platform  String
  version   String?
  userAgent String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, app, platform])
  @@map("app_usage")
}

model CustomMailRecipient {
  id         String     @id
  mailId     String
  email      String
  name       String
  status     String     @default("pending")
  error      String?
  claimedAt  DateTime?
  sentAt     DateTime?
  CustomMail CustomMail @relation(fields: [mailId], references: [id], onDelete: Cascade)

  @@unique([mailId, email], map: "custom_mail_recipients_mail_email_key")
  @@index([mailId, status], map: "custom_mail_recipients_mail_status_idx")
  @@map("custom_mail_recipients")
}

model CustomMail {
  id                  String                @id
  subject             String
  title               String
  body                String
  buttonLabel         String                @default("")
  buttonUrl           String                @default("")
  audience            String
  audienceLabel       String                @default("")
  status              String                @default("sending")
  total               Int                   @default(0)
  sent                Int                   @default(0)
  failed              Int                   @default(0)
  lastError           String?
  createdBy           String
  createdAt           DateTime              @default(now())
  finishedAt          DateTime?
  CustomMailRecipient CustomMailRecipient[]

  @@map("custom_mails")
}

model DeviceLink {
  code       String    @id
  pollHash   String
  app        String    @default("")
  ip         String?
  userAgent  String?
  userId     String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  approvedAt DateTime?
  usedAt     DateTime?

  @@index([pollHash])
  @@map("device_links")
}

model EmailVerifyCode {
  id            String    @id
  userId        String
  challengeHash String    @unique(map: "email_verify_codes_challenge_key")
  codeHash      String
  linkHash      String    @unique(map: "email_verify_codes_link_key")
  tries         Int       @default(0)
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt], map: "email_verify_codes_user_idx")
  @@map("email_verify_codes")
}

model ReferralCode {
  userId    String   @id
  code      String   @unique
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

model Referral {
  referredId                        String    @id
  referrerId                        String
  status                            String    @default("pending")
  note                              String    @default("")
  createdAt                         DateTime  @default(now())
  rewardedAt                        DateTime?
  users_referrals_referredIdTousers User      @relation("referrals_referredIdTousers", fields: [referredId], references: [id], onDelete: Cascade)
  users_referrals_referrerIdTousers User      @relation("referrals_referrerIdTousers", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

model Review {
  id        String   @id
  userId    String
  product   String
  rating    Int
  comment   String   @default("")
  version   String   @default("")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, product], map: "reviews_user_product_key")
  @@index([product, status])
  @@map("reviews")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())

  @@map("site_settings")
}

model SlopeJob {
  id            String   @id
  ownerId       String
  name          String
  data          String
  summary       String   @default("{}")
  clientUpdated String   @default("")
  size          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  User          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("slope_jobs")
}

model Subscription {
  userId      String    @id
  plan        String    @default("free")
  status      String    @default("active")
  periodEnd   DateTime?
  provider    String    @default("manual")
  providerRef String    @default("")
  note        String    @default("")
  updatedBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  customerRef String    @default("")
  eventAt     DateTime?
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerRef])
  @@map("subscriptions")
}

model TeamMember {
  teamId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  Team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamShare {
  id       String   @id
  teamId   String
  kind     String
  itemId   String
  ownerId  String
  note     String   @default("")
  sharedAt DateTime @default(now())
  User     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  Team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, kind, itemId], map: "team_shares_item_key")
  @@map("team_shares")
}

model Team {
  id         String       @id
  name       String
  ownerId    String
  code       String       @unique
  createdAt  DateTime     @default(now())
  TeamMember TeamMember[]
  TeamShare  TeamShare[]
  User       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("teams")
}

model ToolkitDevice {
  id             String         @id
  userId         String
  name           String         @default("")
  windows        String         @default("")
  toolkitVersion String         @default("")
  tools          String         @default("{}")
  firstSeen      DateTime       @default(now())
  lastSeen       DateTime       @default(now())
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ToolkitEvent   ToolkitEvent[]

  @@index([userId])
  @@map("toolkit_devices")
}

model ToolkitEvent {
  id            BigInt        @id @default(autoincrement())
  deviceId      String
  userId        String
  tool          String
  action        String
  fromVersion   String        @default("")
  toVersion     String        @default("")
  message       String        @default("")
  createdAt     DateTime      @default(now())
  ToolkitDevice ToolkitDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([deviceId, createdAt], map: "toolkit_events_deviceId_idx")
  @@map("toolkit_events")
}

model ToolkitHandoff {
  codeHash  String   @id
  userId    String
  next      String
  expiresAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("toolkit_handoffs")
}

model ToolkitTester {
  email     String   @id
  note      String   @default("")
  addedBy   String   @default("")
  createdAt DateTime @default(now())

  @@map("toolkit_testers")
}

model TraverseJobShare {
  jobId       String
  email       String
  createdAt   DateTime    @default(now())
  TraverseJob TraverseJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, email])
  @@index([email])
  @@map("traverse_job_shares")
}

model TraverseJob {
  id               String             @id
  ownerId          String
  kind             String
  name             String
  data             String
  summary          String             @default("{}")
  clientUpdated    String             @default("")
  size             Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  TraverseJobShare TraverseJobShare[]
  User             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("traverse_jobs")
}

model UserEmailStatus {
  userId     String    @id
  required   Boolean   @default(false)
  verifiedAt DateTime?
  method     String?
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_email_status")
}
